    "httpRoute": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "$ref": "https://raw.githubusercontent.com/yannh/kubernetes-json-schema/master/master/objectmeta.json#/properties/annotations",
          "required": []
        },
        "enabled": {
          "default": false,
          "description": "Enable HttpRoute record generation",
          "required": [],
          "title": "enabled",
          "type": "boolean"
        },
        "hostnames": {
          "description": "The DNS name to respond to",
          "items": {
            "required": []
          },
          "required": [],
          "title": "hostnames",
          "type": "array"
        },
        "parentRefs": {
          "items": {
            "required": []
          },
          "required": [],
          "title": "parentRefs",
          "type": "array"
        },
        "rules": {
          "description": "An array of rules to use for the route,\nthe service backend will be automatically added\nto all rules",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "matches": {
                    "items": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "path": {
                              "additionalProperties": false,
                              "properties": {
                                "type": {
                                  "default": "PathPrefix",
                                  "required": [],
                                  "title": "type",
                                  "type": "string"
                                },
                                "value": {
                                  "default": "/",
                                  "required": [],
                                  "title": "value",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "type",
                                "value"
                              ],
                              "title": "path",
                              "type": "object"
                            }
                          },
                          "required": [
                            "path"
                          ],
                          "type": "object"
                        }
                      ],
                      "required": []
                    },
                    "required": [],
                    "title": "matches",
                    "type": "array"
                  }
                },
                "required": [
                  "matches"
                ],
                "type": "object"
              }
            ],
            "required": []
          },
          "required": [],
          "title": "rules",
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "hostnames",
        "parentRefs",
        "rules"
      ],
