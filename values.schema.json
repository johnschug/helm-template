              "default": false,
              "required": [],
              "title": "enabled",
              "type": "boolean"
            },
            "maxAllowed": {
              "additionalProperties": false,
              "required": [],
              "title": "maxAllowed",
              "type": "object"
            },
            "minAllowed": {
              "additionalProperties": false,
              "required": [],
              "title": "minAllowed",
